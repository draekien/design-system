{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "component": {
    "status-media": {
      "ring": {
        "$type": "dimension",
        "$value": {
          "value": 1.5,
          "unit": "px"
        }
      }
    },
    "avatar": {
      "overlap": {
        "$type": "number",
        "$value": 0.5
      }
    },
    "meter": {
      "value-min": {
        "$type": "number",
        "$value": 4,
        "$extensions": {
          "me.wpei.unit": "ch"
        }
      }
    },
    "preview-card": {
      "enter-scale": {
        "$type": "number",
        "$value": 0.97
      }
    },
    "card": {
      "aside-max": {
        "$type": "number",
        "$value": 33,
        "$extensions": {
          "me.wpei.unit": "cqw"
        }
      },
      "media-width": {
        "$type": "number",
        "$value": 100,
        "$extensions": {
          "me.wpei.unit": "cqw"
        }
      },
      "media-height": {
        "$type": "number",
        "$value": 56.25,
        "$extensions": {
          "me.wpei.unit": "cqw"
        }
      }
    }
  }
}
