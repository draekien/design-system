{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITEST", "SITE_BASE_PATH"],
      "outputs": ["dist/**"]
    },
    "check": {},
    "//#lint:biome": {},
    "//#lint:comments": {
      "inputs": ["apps/**", "packages/**", "scripts/check-comments.ts"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "env": ["VITEST"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
